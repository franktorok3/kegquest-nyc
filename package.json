{
  "name": "tapbound",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "ingest": "node scripts/ingest.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "sync:db": "tsx scripts/sync-database.ts",
    "test:unit": "vitest run",
    "ingest:browser": "node scripts/crawl-browser.mjs --all && node scripts/apply-browser-content.mjs && npm run ingest:drops",
    "ingest:drops": "tsx scripts/update-drops.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.57.0",
    "maplibre-gl": "6.14.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "robots-parser": "^3.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "type": "module"
}
